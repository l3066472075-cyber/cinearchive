# 复制为 .env 后填写。所有项均可留空——留空时系统使用离线回退，可完整运行。

# ---- 大模型（生成个性化推荐理由）----
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# ---- 嵌入模型（语义检索）----
# 可接 OpenAI 兼容的 embedding 接口：text-embedding-3 / bge / qwen / 智谱 等
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ---- 微信静默登录（小程序 code2session + 公众号 H5 OAuth 共用）----
# 留空则进入「开发模式」：登录接口用 code 派生稳定伪 openid，便于本地联调
WX_APPID=
WX_APP_SECRET=
# 公众号 H5 网页授权的回调地址（须在公众号「网页授权域名」下）；留空按请求 Host 自动拼接
MP_OAUTH_REDIRECT_URI=

# ---- JWT 鉴权密钥（生产环境务必改为随机长字符串）----
JWT_SECRET=cinelib-dev-secret-change-me
JWT_EXPIRE_MINUTES=10080

# ---- 数据库（本地默认 SQLite；云托管/生产用 MySQL，免费内测用 Postgres）----
# 本地：留空即可（默认 sqlite:///backend/data/cinelib.db）
# CINELIB_DATABASE_URL=sqlite:///./data/cinelib.db
# 云托管 MySQL 示例：
# CINELIB_DATABASE_URL=mysql+pymysql://用户名:密码@mysql内网地址:3306/库名?charset=utf8mb4
# 免费 Postgres（Neon/Supabase/Render）示例：
# CINELIB_DATABASE_URL=postgresql+psycopg2://用户名:密码@host:5432/库名?sslmode=require
